<resources>
    <string name="app_name">ClearScreen</string>
    <string name="wallpaper_description">Streams the rear camera as your background, calibrated so what\'s behind the phone lines up at true size and position.</string>

    <string name="permission_title">Camera access needed</string>
    <string name="permission_body">ClearScreen shows the rear camera feed as your home screen background, so icons appear to float over a see-through phone. It needs the Camera permission to do that. The camera only turns on while the wallpaper is actually on screen, and never when another app is open or the screen is off.</string>
    <string name="permission_grant">Grant camera permission</string>
    <string name="permission_denied_settings">Camera permission was denied. Open app settings to grant it.</string>
